# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and keys from Supabase → Project Settings → API.
# Run supabase/schema.sql in the SQL editor, then everything in supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses every Row-Level Security policy — treat it like a root
# password. Used by the unauthenticated voice routes, which cannot carry a session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required. Read only in /api/realtime/connect and never sent to the browser.
OPENAI_API_KEY=sk-proj-your-key
OPENAI_REALTIME_MODEL=gpt-realtime

# ── App ──────────────────────────────────────────────────────────────────────
# Used to build widget embed snippets, so it must match the deployed origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: business id for the live demo widget on the landing page.
# Leave empty to hide it.
NEXT_PUBLIC_DEMO_BUSINESS_ID=

NEXT_PUBLIC_ENABLE_VOICE=true

# ── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret for the scheduled sweeper that closes conversations abandoned by
# a client that never came back (tab close, crash, dead network). Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET`. If unset, the endpoint stays
# closed rather than becoming publicly runnable.
CRON_SECRET=generate-a-long-random-string
